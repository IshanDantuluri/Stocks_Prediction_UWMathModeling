# Copy to .env and replace the placeholder. Never commit the real key.
DEEPSEEK_API_KEY=replace_me

# Optional data collectors. SEC_USER_AGENT should identify the requester and
# include a monitored contact address, per SEC fair-access guidance.
SEC_USER_AGENT=Your_Name your_email@example.com
FRED_API_KEY=replace_me
ALPHA_VANTAGE_API_KEY=replace_me
